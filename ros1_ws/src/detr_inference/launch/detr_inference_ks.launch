<launch>
   
    <arg name="pub_detection_image" default="true"/>
    <arg name="save_video_enabled" default="true"/>
    
    <arg name="hub_id" default="ARG-NCTU"/>
    <arg name="repo_id" default="detr-resnet-50-finetuned-600-epochs-Kaohsiung-Port-dataset"/>

    <arg name="classes_path" default="$(find detr_inference)/classes/Kaohsiung_Port_classes.txt"/>

    <arg name="confidence_threshold" default="0.5"/>

    <node name="detr_inference" pkg="detr_inference" type="detr_inference.py" output="screen">
        <param name="sub_camera_topic" value="/camera2_pad/color/image_raw/compressed"/>
        <param name="pub_camera_topic" value="/detection_result_img/camera2/compressed"/>
        <param name="hub_id" value="$(arg hub_id)"/>
        <param name="repo_id" value="$(arg repo_id)"/>
        <param name="classes_path" value="$(arg classes_path)"/>
        <param name="confidence_threshold" value="$(arg confidence_threshold)"/>
        <param name="pub_detection_image" value="$(arg pub_detection_image)"/>
        <param name="pub_scores_topic" value="~detection_scores"/>
        <param name="pub_labels_topic" value="~detection_labels"/>
        <param name="pub_boxes_topic" value="~detection_boxes"/>
        <param name="pub_boxes_bottom_topic" value="~detection_boxes_bottom"/>
        <param name="save_video_enabled" value="$(arg save_video_enabled)" />
        <param name="video_output_path" value="$(find detr_inference)/output_videos/output.mp4" />
        <param name="video_fps" value="30" />
    </node>

</launch>
